.{
    .id = "au.com.bellizzi.mdv",
    .name = "mdv",
    .display_name = "mdv",
    .description = "Minimalist markdown viewer.",
    .version = "0.1.0",
    .icons = .{ "assets/icon.png" },
    .platforms = .{ "macos", "linux" },
    .permissions = .{},
    .capabilities = .{ "webview", "file_associations" },
    .bridge = .{
        .commands = .{
            .{ .name = "mdv.pending" },
            .{ .name = "mdv.stat" },
            .{ .name = "mdv.read" },
            .{ .name = "mdv.assign" },
            .{ .name = "mdv.claim" },
            .{ .name = "mdv.config" },
            .{ .name = "mdv.configWrite" },
        },
    },
    .commands = .{
        .{ .id = "mdv.settings", .title = "Appearance Settings" },
        .{ .id = "mdv.toc", .title = "Table of Contents" },
        .{ .id = "mdv.find", .title = "Find" },
        .{ .id = "mdv.findNext", .title = "Find Next" },
        .{ .id = "mdv.findPrev", .title = "Find Previous" },
    },
    .menus = .{
        .{
            .title = "Settings",
            .items = .{
                .{ .label = "Appearance...", .command = "mdv.settings", .key = ",", .modifiers = .{"command"} },
                .{ .label = "Table of Contents", .command = "mdv.toc", .key = "o", .modifiers = .{ "command", "shift" } },
            },
        },
        .{
            .title = "Find",
            .items = .{
                .{ .label = "Find...", .command = "mdv.find", .key = "f", .modifiers = .{"command"} },
                .{ .label = "Find Next", .command = "mdv.findNext", .key = "g", .modifiers = .{"command"} },
                .{ .label = "Find Previous", .command = "mdv.findPrev", .key = "g", .modifiers = .{ "command", "shift" } },
            },
        },
    },
    .file_associations = .{
        .{
            .name = "Markdown Document",
            .role = "viewer",
            .extensions = .{ "md", "markdown", "mdown", "mkd" },
            .mime_types = .{ "text/markdown" },
        },
    },
    .frontend = .{
        .dist ="frontend/dist",
        .entry = "index.html",
        .spa_fallback = true,
        .dev = .{
            .url ="http://127.0.0.1:5173/",
            .command = .{ "npm", "--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1" },
            .ready_path = "/",
            .timeout_ms = 30000,
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline", "http://127.0.0.1:5173" },
            .external_links = .{ .action = "open_system_browser", .allowed_urls = .{"*"} },
        },
    },
    .web_engine = "system",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
    .windows = .{
        .{ .label = "main", .title = "mdv", .width = 860, .height = 900, .restore_state = true },
    },
}
